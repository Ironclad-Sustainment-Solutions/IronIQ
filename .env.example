# Copy to .env and fill in real values. Never commit the real .env.

# Postgres connection string. Render provides this automatically for the
# web service; for local dev, point it at your own `createdb ironiq_dev`.
DATABASE_URL=postgresql://user:password@localhost:5432/ironiq_dev

# Used to sign/encrypt session cookies. Generate a real random value, e.g.:
#   openssl rand -hex 32
# Render wires this automatically via render.yaml; for local dev, any long
# random string works, but don't reuse a real production secret.
SESSION_SECRET=change-me-to-a-long-random-string

NODE_ENV=development

# Required for all AI features (manufacturing plan generation, capability/
# field AI analysis, intelligence-layer pattern matching). Get one from
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Used for the Intelligence layer's reference-pattern embeddings
# (text-embedding-3-small). Optional in the sense that the app runs fine
# without it -- patterns just get saved without a searchable embedding
# until this is set, per embeddings.server.ts's own comment.
OPENAI_API_KEY=

# S3-compatible object storage (Cloudflare R2, AWS S3, MinIO, etc.) for
# evidence photos, CAD files, and other uploads. All four are required —
# file upload/download features will fail without them.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# IronIQ Edge machine-event ingest (POST /api/ironiq/v1/machine-events)
# authenticates per facility, not with one shared secret here -- each
# facility gets its own edge ingest key (generate one from the
# facility's admin page in IronIQ, hashed at rest, shown once). No
# env var needed for this.

# Idle gap in minutes before IronIQ sets gap_class=SETUP_CANDIDATE on
# ingested machine events. Default 15 if unset.
# IRONIQ_IDLE_GAP_MINUTES=15

# Google and Microsoft 365 (Entra ID) sign-in. Both optional -- omit
# either provider's variables and that provider's sign-in button simply
# returns "not configured" instead of failing the app build/start.
# IRONIQ_BASE_URL is required by both (used to construct the OAuth
# redirect URI, e.g. https://your-ironiq-domain.example) -- must exactly
# match the redirect URI registered with each provider.
IRONIQ_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" (default if unset) accepts sign-in from any Microsoft 365
# tenant. Set this to a specific tenant ID/domain to restrict sign-in to
# one organization's Microsoft 365 instead.
# MICROSOFT_TENANT_ID=common
